{
  "version": "0.3.0",
  "description": "Adds support for Farcaster names (fnames) in MetaMask.",
  "proposedName": "Farcaster Names",
  "repository": {
    "type": "git",
    "url": "https://github.com/Montoya/social-names-snap.git"
  },
  "source": {
    "shasum": "8/GfXWzWfCCCuKeEmqnExFPK2rPYd+IsVSn1d0rmHxM=",
    "location": {
      "npm": {
        "filePath": "dist/bundle.js",
        "iconPath": "img/icon.svg",
        "packageName": "social-names-snap",
        "registry": "https://registry.npmjs.org/"
      }
    }
  },
  "initialPermissions": {
    "endowment:name-lookup": {
